# The backend of Discord Server Manager.
#
# Install with:
#   sudo cp deploy/discord-server-manager.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now discord-server-manager
#
# The secrets live in /etc/discord-server-manager.env, not in the unit.

[Unit]
Description=Discord Server Manager backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=discord-server-manager
Group=discord-server-manager
WorkingDirectory=/opt/discord-server-manager
EnvironmentFile=/etc/discord-server-manager.env
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

# The service only needs to write its database.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/discord-server-manager/data

StandardOutput=journal
StandardError=journal
SyslogIdentifier=discord-server-manager

[Install]
WantedBy=multi-user.target
